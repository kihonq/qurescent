---
import Verse from "@components/Verse";
import Layout from "@layouts/Layout.astro";
import { fetchChapter } from "@helpers/chapter";
// PROTOTYPE for wayfinder ticket #8 (multi-translation switcher UX) — throwaway, see
// .agents/skills/prototype/SKILL.md. Drop these imports and the two extra mounts below once a
// variant wins and the decision is folded into the real design.
import TranslationStack from "@components/prototypes/translationSwitcher/TranslationStack";
import PageHeaderExtras from "@components/prototypes/translationSwitcher/PageHeaderExtras";
import PrototypeSwitcher from "@components/prototypes/translationSwitcher/PrototypeSwitcher";

const chapterID = Number(Astro.params.id ?? 0);
const chapter = await fetchChapter(chapterID);

if (!chapter) {
  return Astro.redirect("/404");
}

// PROTOTYPE: read on the server so SSR and the first client render agree — reading
// window.location on the client only caused a hydration mismatch (SSR always saw "no window",
// so a deep link like ?variant=B rendered A until the first click re-synced it).
const initialVariant = Astro.url.searchParams.get("variant") ?? "A";
---

<Layout
  title={`Surah ${chapter.englishName}: ${chapter.englishNameTranslation}`}
  description={`Surah ${chapter.englishName}: ${chapter.englishNameTranslation}`}
>
  <section
    class="container mx-auto mt-7 flex flex-col rounded-2xl bg-gray-100 p-4 transition duration-150 dark:bg-container-300 md:w-1/2 lg:w-3/4"
  >
    <div class="m-4 flex flex-row justify-between">
      <h2
        class="flex justify-center space-x-1 text-base transition duration-150 dark:text-slate-300"
      >
        <strong>{chapter.englishName}</strong>:
        <span>{chapter.englishNameTranslation}</span>
      </h2>
      <h2
        class="font-surah-name text-4xl transition duration-150 dark:text-slate-300"
      >
        {chapter.id.toString().padStart(3, "0")}
      </h2>
      <PageHeaderExtras initialVariant={initialVariant} client:load />
    </div>
    {
      chapter.id !== 1 && (
        <div class="mt-4 flex justify-center">
          <h1 class="font-hafs-uthmanic text-4xl transition duration-150 dark:text-slate-300">
            ﷽
          </h1>
        </div>
      )
    }
    <div class="flex justify-center">
      <article
        dir="rtl"
        class="prose mx-5 mt-10 dark:prose-invert lg:prose-2xl"
      >
        {
          chapter.verses.map((verse) => (
            <>
              <Verse verse={verse} />
              <TranslationStack
                verseNumber={verse.numberInSurah}
                initialVariant={initialVariant}
                client:load
              />
            </>
          ))
        }
      </article>
    </div>
  </section>
  <PrototypeSwitcher initialVariant={initialVariant} client:load />
</Layout>
