---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Fuse from "fuse.js";
import Chapter from "@components/Chapter";
import { getChapters } from "@helpers/chapter";

let chapters = getChapters();

const q = Astro.url.searchParams.get("q")?.toLowerCase();

if (q) {
  const fuse = new Fuse(chapters, {
    threshold: 0.2,
    keys: ["id", "name", "englishName", "englishNameTranslation"],
  });
  const fused = fuse.search(q);
  chapters = fused.map(({ item }) => item);
}
---

<StarlightPage
  frontmatter={{
    title: "Mushaf",
    description: "Browse all 114 surahs — tajweed-colored text, word-by-word, translations.",
    tableOfContents: false,
    editUrl: false,
  }}
>
  <div class="quran-reader not-content">
    <form class="mb-6">
      <input
        type="search"
        placeholder="Filter surahs…"
        name="q"
        value={q ?? ""}
        class="w-full rounded-lg border border-(--sl-color-gray-5) bg-(--sl-color-gray-6) px-4 py-3 text-sm text-(--sl-color-white) placeholder:text-(--sl-color-gray-3) focus:outline-none focus:ring-2 focus:ring-(--sl-color-accent)"
      />
    </form>

    {
      !chapters.length ? (
        <p class="text-center text-(--sl-color-gray-3)">No surah found.</p>
      ) : (
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
          {chapters.map((chapter) => (
            <Chapter chapter={chapter} />
          ))}
        </div>
      )
    }
  </div>
</StarlightPage>
