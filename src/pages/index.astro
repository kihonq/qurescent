---
import Fuse from "fuse.js";
import Chapter from "@components/Chapter";
import Layout from "@layouts/Layout.astro";

import type { IChapter } from "_types/chapter";

const res = await fetch("http://127.0.0.1:3000/api/chapters");
let chapters: IChapter[] = (await res.json()) ?? [];

const q = Astro.url.searchParams.get("q")?.toLowerCase();

if (q) {
  const fuse = new Fuse(chapters, {
    threshold: 0.2,
    keys: ["id", "name", "englishName", "englishNameTranslation"],
  });
  const fused = fuse.search(q);
  chapters = fused.map(({ item }) => item);
}
---

<Layout>
  <main class="text-center mx-auto text-gray-700 p-4">
    <div class="mb-3 pt-0">
      <form>
        <input
          type="text"
          placeholder="Search"
          name="q"
          value={q}
          class="px-4 transition duration-150 py-3 placeholder-slate-30 dark:placeholder-input-50 dark:text-slate-300 dark:bg-container-300 dark:focus:bg-container-50 focus:bg-gray-100 bg-gray-200 relative rounded-3xl text-sm focus:outline-none focus:ring ring-amber-100 w-full"
        />
      </form>
    </div>
    <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
      {chapters.map((chapter) => <Chapter chapter={chapter} />)}
    </div>
  </main>
</Layout>

<style lang="scss">
  @font-face {
    font-family: "Hafs Uthmanic";
    src: local("KFGQPC HAFS Uthmanic Script Regular"),
      url("/fonts/hafs-uthmanic.woff2") format("woff2"),
      url("/fonts/hafs-uthmanic.ttf") format("truetype");
    font-display: swap;
  }

  @font-face {
    font-family: "Surah Name";
    src: local("sura_names"), url("/fonts/surah-name.woff2") format("woff2"),
      url("/fonts/surah-name.woff") format("woff"),
      url("/fonts/surah-name.ttf") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
