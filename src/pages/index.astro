---
import Fuse from "fuse.js";
import Chapter from "@components/Chapter";
import Layout from "@layouts/Layout.astro";

import { fetchChapters } from "@helpers/chapter";

let chapters = await fetchChapters();

const q = Astro.url.searchParams.get("q")?.toLowerCase();

if (q) {
  const fuse = new Fuse(chapters, {
    threshold: 0.2,
    keys: ["id", "name", "englishName", "englishNameTranslation"],
  });
  const fused = fuse.search(q);
  chapters = fused.map(({ item }) => item);
}
---

<Layout>
  <main class="mx-auto p-4 text-center text-gray-700">
    <div class="mb-3 pt-0">
      <form>
        <input
          type="text"
          placeholder="Search"
          name="q"
          value={q}
          class="placeholder-slate-30 relative w-full rounded-3xl bg-gray-200 px-4 py-3 text-sm ring-amber-100 transition duration-150 focus:bg-gray-100 focus:outline-none focus:ring dark:bg-container-300 dark:text-slate-300 dark:placeholder-input-50 dark:focus:bg-container-50"
        />
      </form>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        !chapters.length ? (
          <p class="text-center text-gray-300 dark:text-gray-800">
            No surah found.
          </p>
        ) : (
          chapters.map((chapter) => <Chapter chapter={chapter} />)
        )
      }
    </div>
  </main>
</Layout>
