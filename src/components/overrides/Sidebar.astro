---
/**
 * Use custom SidebarSublist (no nest hairlines; Mushaf surah scroll).
 * SidebarSublist is not a virtual slot — must rewire via Sidebar override.
 * @see https://starlight.astro.build/guides/overriding-components/
 */
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "../../../node_modules/@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "./SidebarSublist.astro";

const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
